# call-center-admin — example environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# ---------- Claude Code hooks ----------

# Slack webhook for `.claude/hooks/notify.sh` (optional)
CLAUDE_NOTIFY_WEBHOOK=

# ---------- Local development ----------

# AWS region for boto3 (overrides default)
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2

# Bedrock model IDs (only needed for `scripts/eval_prompt.py` against real Bedrock)
MODEL_ID=global.anthropic.claude-opus-4-7
VERIFY_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Prompt directory for local testing (Lambda runtime uses /var/task/prompts/v1.0)
PROMPT_DIR=src/prompts/v1.0

# ---------- AWS credentials ----------

# DO NOT put real AWS keys here. Use one of:
# - aws sso login --profile callcenter-dev
# - aws-vault exec callcenter-dev -- pytest
# - GitHub Actions OIDC (no static keys in CI either)
#
# If you absolutely must (local one-off):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
